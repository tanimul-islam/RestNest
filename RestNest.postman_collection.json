    {
      "name": "User LogIn",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "  pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Login succeeded\", function () {\r",
              "  const response = pm.response.json();\r",
              "\r",
              "  pm.expect(response.success).to.eql(true);\r",
              "  pm.expect(response.data).to.have.property(\"accessToken\");\r",
              "  pm.expect(response.data).to.have.property(\"user\");\r",
              "  pm.expect(response.data.user.email).to.eql(\"tenant@test.com\");\r",
              "});\r",
              "\r",
              "pm.test(\"Refresh token is not exposed\", function () {\r",
              "  const response = pm.response.json();\r",
              "\r",
              "  pm.expect(response.data).to.not.have.property(\"refreshToken\");\r",
              "});\r",
              "\r",
              "const response = pm.response.json();\r",
              "\r",
              "if (response.data?.accessToken) {\r",
              "  pm.environment.set(\"accessToken\", response.data.accessToken);\r",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
